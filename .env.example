# ===================== DATABASE =====================
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smartshop

# ===================== APIFY =====================
# Get your token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN
# Actor ID (or username/actor-name) for an Amazon product-search scraper actor
AMAZON_ACTOR_ID=YOUR_AMAZON_APIFY_ACTOR_ID
# Actor ID (or username/actor-name) for a Flipkart product-search scraper actor
FLIPKART_ACTOR_ID=YOUR_FLIPKART_APIFY_ACTOR_ID
# Max seconds to wait for an actor run before giving up
APIFY_RUN_TIMEOUT_SECONDS=90

# ===================== LLM =====================
# Use either OpenAI OR Azure OpenAI. LLM_PROVIDER = "openai" | "azure" | "none"
LLM_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=YOUR_AZURE_OPENAI_ENDPOINT
AZURE_OPENAI_DEPLOYMENT=YOUR_AZURE_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===================== AUTH =====================
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_INVITE_CODE=YOUR_PRIVATE_ADMIN_INVITE_CODE

# ===================== EMBEDDINGS =====================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./faiss_index

# ===================== MISC =====================
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
